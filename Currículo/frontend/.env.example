# ==============================================================================
# CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE - PORTFÓLIO PROFISSIONAL v3.0
# Copie este arquivo para .env.local e preencha conforme necessário.
# NUNCA insira tokens ou senhas reais no repositório Git!
# ==============================================================================

# URL Canônica do Site (Opcional: usa o domínio gratuito .vercel.app por padrão;
# defina quando adquirir um domínio próprio, ex: https://eliasreis.dev)
NEXT_PUBLIC_SITE_URL="https://curr-culo-v-2-0-8kbn.vercel.app"

# ------------------------------------------------------------------------------
# BANCO DE DADOS POSTGRESQL (CMS ADMINISTRATIVO)
# Suporta Vercel Postgres, Neon, Supabase ou instância PostgreSQL dedicada
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://usuario:senha@host:5432/nomedobanco?sslmode=require"
# DIRECT_URL="" # Opcional: conexão direta para migrations quando utilizando poolers (Neon/Supabase)

# ------------------------------------------------------------------------------
# AUTENTICAÇÃO ADMINISTRATIVA (GOOGLE OAUTH 2.0 / OPENID CONNECT)
# ------------------------------------------------------------------------------
# Segredo criptográfico para proteção de sessões e tokens JWT (Gere com: openssl rand -base64 32)
AUTH_SECRET=""
NEXTAUTH_URL="https://curr-culo-v-2-0-8kbn.vercel.app"

# Credenciais do Google Cloud Console (OAuth 2.0 Client IDs)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Conta Administrativa Única Autorizada (Zero Trust)
# O acesso ao CMS é restrito exclusivamente ao e-mail Google verificado e ao sub imutável configurados aqui.
GOOGLE_ADMIN_EMAIL="reis.elias.ribeiro@gmail.com"
GOOGLE_ADMIN_SUB="" # Identificador numérico imutável (sub) da conta Google (OBRIGATÓRIO em produção)

# Ativação do Formulário via API Resend (Padrão: "false" enquanto utiliza domínio .vercel.app
# com envio direto via aplicativo de e-mail mailto:. Mude para "true" após verificar domínio no Resend)
NEXT_PUBLIC_CONTACT_API_ENABLED="false"

# Provedor de E-mail (Resend - https://resend.com)
# Obtenha sua API key no painel do Resend e configure após validar seu domínio próprio via DNS
RESEND_API_KEY=""

# E-mail de destino das mensagens enviadas pelos visitantes do portfólio
CONTACT_DESTINATION_EMAIL="elias.re_is@hotmail.com"

# E-mail remetente de domínio próprio verificado no Resend (ex: contato@seudominio.com.br)
CONTACT_FROM_EMAIL=""

# Salt para anonimização criptográfica de IP no Rate Limiter (Opcional, gera aleatório se vazio)
RATE_LIMIT_SALT=""

# Rate Limiter Distribuído Serverless (Upstash Redis ou Vercel KV)
# Obrigatório para ambientes de produção serverless com múltiplas instâncias
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Política de Falha do Redis em Produção:
# O padrão em produção é estritamente FAIL-CLOSED (rejeição segura com HTTP 503 se Redis falhar).
# Defina RATE_LIMIT_ALLOW_DEGRADED_FALLBACK="true" apenas se desejar permitir fallback local degradado (máx 2 reqs).
RATE_LIMIT_ALLOW_DEGRADED_FALLBACK="false"

# Permitir ausência de Redis em produção (padrão: false - bloqueia por segurança se Redis não for configurado)
RATE_LIMIT_ALLOW_UNCONFIGURED_IN_PROD="false"

# Modo de Teste para o serviço de mensageria (true/false)
MOCK_EMAIL_SERVICE="false"

